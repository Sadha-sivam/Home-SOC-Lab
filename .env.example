# ── home-soc-lab secrets & version pins ──────────────────────────────────────
# Copy to .env and change EVERY password. Never commit .env (see .gitignore).
# Version note: pin to each project's current stable at build time — check release
# notes rather than trusting these. These are known-good tags as of this writing.

# ── Wazuh (SIEM) ─────────────────────────────────────────────────────────────
WAZUH_VERSION=4.9.2
# IMPORTANT: INDEXER_PASSWORD and DASHBOARD_PASSWORD are bcrypt-coupled to the
# hashes in config/wazuh_indexer/internal_users.yml. These two defaults MATCH the
# shipped hashes so the stack boots out of the box. To change them you must also
# regenerate the hashes — do it AFTER first boot via docs/hardening.md
# (wazuh-passwords-tool). Changing only the value here WILL break indexer auth.
INDEXER_PASSWORD=SecretPassword
DASHBOARD_PASSWORD=kibanaserver
# Wazuh manager REST API user (wazuh-wui). This one is NOT hash-coupled — set it
# to anything strong; the manager reads it straight from this env var.
API_PASSWORD=ChangeMe_WazuhAPI_2026!

# ── TheHive + Cortex (case mgmt) ─────────────────────────────────────────────
THEHIVE_VERSION=5.4
CORTEX_VERSION=3.1.7
CASSANDRA_VERSION=4.1
# TheHive secret key (regenerate: openssl rand -base64 64 | tr -d '\n')
THEHIVE_SECRET=ChangeMe_TheHive_Secret_Key_Base64
CORTEX_SECRET=ChangeMe_Cortex_Secret_Key_Base64

# ── MISP (threat intel) ──────────────────────────────────────────────────────
MISP_VERSION=core-latest
MISP_ADMIN_EMAIL=admin@admin.test
MISP_ADMIN_PASSWORD=ChangeMe_MISP_2026!
MISP_BASEURL=https://localhost:8443

# ── Shuffle (SOAR) ───────────────────────────────────────────────────────────
SHUFFLE_VERSION=1.4.0
SHUFFLE_OPENSEARCH_PASSWORD=ChangeMe_Shuffle_OS_2026!

# ── Enrichment API keys (fill what you have; analyzers degrade gracefully) ────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# MISP auth key is generated in the MISP UI after first boot, then pasted here
# and into Cortex's MISP analyzer + Shuffle's MISP app.
MISP_AUTH_KEY=
